# Copy to backend/.env for local development.
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me            # required when DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# REDIS_URL=redis://localhost:6379/0     # optional shared cache (default: in-process memory)
# DEMO_MODE=true                         # serve recorded API fixtures instead of live APIs
# OPEN_METEO_API_KEY=                    # optional commercial Open-Meteo key
# OSRM_BASE_URL=https://router.project-osrm.org
# TRUCK_SPEED_CAP_MPH=65
